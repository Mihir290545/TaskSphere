# TaskFlow Environment Configuration Template

# Application Settings
APP_NAME="TaskFlow"
APP_ENV=production        # Change to 'production' on live hosts
APP_DEBUG=false           # Set to 'false' on live hosts to prevent error disclosure
APP_URL=https://yourdomain.com

# Database Connection (MySQL / MariaDB)
# For Shared Hosting (cPanel / Hostinger / InfinityFree):
# DB_HOST is usually 'localhost' or an IP provided in your hosting cPanel.
# DB_NAME & DB_USER usually carry your cPanel prefix, e.g. u123456_taskflow
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taskflow_db
DB_USER=root
DB_PASS=

# Session Configuration
SESSION_LIFETIME=7200
SESSION_SECURE=false      # Set to 'true' if your website runs over HTTPS (SSL)
